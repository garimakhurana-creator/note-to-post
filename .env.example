# Copy to .env for local runs. On Vercel, set these in the project's Environment Variables.

# Gemini. Search grounding supplies the news angle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Telegram bot from @BotFather.
TELEGRAM_BOT_TOKEN=
# Only notes from this chat are used. Send /start to the bot to get the id.
TELEGRAM_CHAT_ID=
# Random string Telegram sends back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# Notes scoring below this are not drafted (1-10). Raise it for fewer posts.
MIN_SCORE=7
