# Copy to .env and fill in. Nothing here is ever posted anywhere public.

# Gemini (same key the sales-intel app uses). Search grounding supplies the news angle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Telegram bot from @BotFather. Meera keeps messaging it exactly as she does now.
TELEGRAM_BOT_TOKEN=
# Only notes from this chat are accepted, and "draft ready" pings go here.
# Leave blank, send /start to the bot, and it will reply with the id to paste here.
TELEGRAM_CHAT_ID=

# Where the review page lives - included in the "draft ready" ping.
PUBLIC_URL=http://localhost:3300
PORT=3300

# Cadence: one draft on each of these days, at this local hour, until the weekly target is met.
DRAFT_DAYS=Mon,Wed,Fri
DRAFT_HOUR=8
WEEKLY_TARGET=3
TIMEZONE=Asia/Kolkata

# ---- Deployed (Vercel) only ----
# Password for the review page.
APP_PASSWORD=
# Random strings: Telegram and Vercel Cron send these back so nobody else can call those routes.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# Storage: added automatically when you connect Upstash Redis in the Vercel dashboard.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
